# Copy to .env and fill values to enable SMTP sending
# Example using Gmail SMTP (use App Password or proper credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Tu Sitio" <no-reply@example.com>
CONTACT_TO=contacto@tu-dominio.com
PORT=5000
